/******************************
脚本名称: 每日60S
Version : v1.4.0
平台: Egern
功能: 每日60秒读懂世界（定时通知）
显示 15 条新闻
*******************************/

const SCRIPT_NAME = "每日60S";
const TITLE_MAIN = "每日60S · 读懂世界 💭";
const MAX_NEWS = 15;

function todayStr() {
  const d = new Date();
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
}

function buildUrls(date) {
  return [
    `https://60s-static.viki.moe/60s/${date}.json`,
    `https://cdn.jsdmirror.com/gh/vikiboss/60s-static-host@main/static/60s/${date}.json`,
    `https://cdn.jsdelivr.net/gh/vikiboss/60s-static-host@main/static/60s/${date}.json`,
  ];
}

function log(msg) {
  console.log(`[${SCRIPT_NAME}] ${msg}`);
}

function buildBody(news, tip) {
  const lines = news.slice(0, MAX_NEWS).map((item, i) => `${i + 1}. ${item}`);
  if (tip) {
    lines.push("");
    lines.push(`【微语】${tip}`);
  }
  return lines.join("\n");
}

async function fetchJson(ctx, url) {
  const resp = await ctx.http.get(url, {
    headers: { Accept: "application/json", "User-Agent": "Egern-60s/1.4.0" },
    timeout: 15000,
  });
  if (resp.status < 200 || resp.status >= 300) throw new Error(`HTTP ${resp.status}`);
  return JSON.parse(await resp.text());
}

async function load60s(ctx, date) {
  let lastErr;
  for (const url of buildUrls(date)) {
    try {
      log(`请求: ${url}`);
      const json = await fetchJson(ctx, url);
      if (json && Array.isArray(json.news)) return json;
      lastErr = new Error("返回数据格式异常");
    } catch (e) {
      lastErr = e;
      log(`失败: ${e.message}`);
    }
  }
  throw lastErr || new Error("全部接口失败");
}

function notify(ctx, title, subtitle, body) {
  const payload = { title, subtitle, body, sound: true };
  if (ctx && typeof ctx.notify === "function") {
    try { ctx.notify(payload); return; } catch (_) {}
  }
  if (typeof $notification !== "undefined") {
    try { $notification.post(title, subtitle, body); } catch (_) {}
  }
}

async function main(ctx) {
  const date = todayStr();
  log(`开始获取 ${date}`);
  try {
    const data = await load60s(ctx, date);
    const subtitle = [data.date, data.created ? data.created.split(" ")[0] : ""].filter(Boolean)[0] || date;
    const body = buildBody(data.news, data.tip);
    notify(ctx, TITLE_MAIN, subtitle, body);
    log("推送完成");
  } catch (err) {
    const msg = String(err.message || err).slice(0, 200);
    log(`失败: ${msg}`);
    notify(ctx, TITLE_MAIN, "获取失败", msg);
  }
}

export default main;
